# =============================================================================
# LANGSMITH
# =============================================================================
LANGSMITH_PROJECT="browser-agent"
LANGSMITH_TRACING="true"
LANGSMITH_API_URL="https://api.smith.langchain.com"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_WORKSPACE_ID=""
# Git commit SHA of the deployed code; traced as `revision_id`. Set before `mda deploy`.
LANGSMITH_REVISION_ID=""
# Traced as `environment` (e.g. dev, production). Unset means `local`.
APP_ENV=""

# =============================================================================
# LANGSMITH - GATEWAY
# =============================================================================
LC_GATEWAY_KEY=""

ANTHROPIC_BASE_URL="https://gateway.smith.langchain.com/anthropic"
ANTHROPIC_API_KEY=${LC_GATEWAY_KEY}

OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"
OPENAI_API_KEY=${LC_GATEWAY_KEY}

GOOGLE_GEMINI_BASE_URL="https://gateway.smith.langchain.com/gemini"
GOOGLE_API_KEY=${LC_GATEWAY_KEY}
GEMINI_API_KEY=${LC_GATEWAY_KEY}

FIREWORKS_BASE_URL="https://gateway.smith.langchain.com/fireworks"
FIREWORKS_API_KEY=${LC_GATEWAY_KEY}

BASETEN_BASE_URL="https://gateway.smith.langchain.com/baseten/v1"
BASETEN_API_KEY=${LC_GATEWAY_KEY}
